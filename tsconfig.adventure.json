{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/design-adventure/**/*.ts",
    "src/design-adventure/**/*.tsx",
    "tests/design-adventure/**/*.ts",
    "playwright.adventure.config.ts"
  ]
}
